{
  "name": "ciaso-web",
  "version": "2.0.0",
  "private": true,
  "description": "CIASO website: public site, form API and admin dashboard (Next.js + libSQL/SQLite).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:setup": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/setup-db.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@libsql/client": "0.15.15",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "next": "15.5.28",
    "nodemailer": "7.0.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/nodemailer": "7.0.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3"
  }
}
