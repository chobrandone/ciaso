# Copy to .env.local for development. In production set these in your host's environment.

# Public URL of the site (used for canonical URLs, sitemap, Open Graph)
SITE_URL=http://localhost:3000

# Database. Local SQLite file by default.
# Production on a server with a persistent disk: file:/data/ciaso.db
# Production on Vercel/serverless: a Turso URL, e.g. libsql://ciaso-<org>.turso.io
DATABASE_URL=file:./data/ciaso.db
DATABASE_AUTH_TOKEN=

# Long random string used to sign admin sessions (REQUIRED in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# First admin account, created by `npm run db:setup` if no admin exists yet.
ADMIN_EMAIL=admin@ciaso.ca
ADMIN_PASSWORD=
ADMIN_NAME=CIASO Admin

# Optional: email a notification to CIASO for every new form submission.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CIASO <admin@ciaso.ca>"
NOTIFY_EMAIL=admin@ciaso.ca
